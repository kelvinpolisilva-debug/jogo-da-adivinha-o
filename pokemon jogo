# =========================================================
# Sistema de tipos
# =========================================================

def listar_fraquezas(tipo):
    return [
        tipo_ataque
        for tipo_ataque, tipo_alvo in TABELA_VANTAGENS.items()
        if tipo_alvo == tipo
    ]


def calcular_bonus_tipo(tipo_ataque, tipo_defensor):
    if TABELA_VANTAGENS.get(tipo_ataque) == tipo_defensor:
        return 1.5

    return 1.0


# =========================================================
# Escolha do Pokémon pelo jogador
# =========================================================

def escolher_pokemon_jogador(pokedex):

    print("===================================")
    print("       ESCOLHA SEU POKÉMON")
    print("===================================")

    for indice, fabrica in enumerate(pokedex, start=1):

        preview = fabrica()

        fraquezas = listar_fraquezas(preview.tipo)

        if fraquezas:
            texto_fraqueza = (
                f" | Fraco contra: {', '.join(fraquezas)}"
            )
        else:
            texto_fraqueza = ""

        print(
            f"{indice} - {preview.nome} "
            f"({preview.tipo}) | "
            f"HP: {preview.vida_max} | "
            f"ATK: {preview.ataque} | "
            f"DEF: {preview.defesa}"
            f"{texto_fraqueza}"
        )

    while True:

        entrada = input(
            "\nDigite o número do Pokémon: "
        ).strip()

        if not entrada.isdigit():
            print("Digite apenas um número.")
            continue

        escolha = int(entrada)

        if 1 <= escolha <= len(pokedex):

            indice = escolha - 1

            return indice, pokedex[indice]()

        print("Opção inválida. Escolha um Pokémon da lista.")


# =========================================================
# Escolha do Pokémon do computador
# =========================================================

def escolher_pokemon_computador(
    pokedex,
    indice_do_jogador
):

    opcoes = [
        fabrica
        for indice, fabrica in enumerate(pokedex)
        if indice != indice_do_jogador
    ]

    fabrica_sorteada = random.choice(opcoes)

    return fabrica_sorteada()


# =========================================================
# Cálculo do dano
# =========================================================

def calcular_dano(atacante, golpe, defensor):

    dano_base = (
        atacante.ataque
        + golpe.poder
        - defensor.defesa
    )

    if dano_base < 1:
        dano_base = 1

    bonus = calcular_bonus_tipo(
        golpe.tipo,
        defensor.tipo
    )

    dano = int(dano_base * bonus)

    if dano < 1:
        dano = 1

    foi_super_efetivo = bonus > 1.0

    return dano, foi_super_efetivo


# =========================================================
# Ataque
# =========================================================

def atacar(
    atacante,
    golpe_escolhido,
    defensor
):

    # Ataque desesperado
    if golpe_escolhido is None:

        dano = 4

        defensor.receber_dano(dano)

        print(
            f"\n{atacante.nome} está sem combustível!"
        )

        print(
            f"{atacante.nome} usou "
            f"ATAQUE DESESPERADO!"
        )

        print(
            f"Causou {dano} de dano em "
            f"{defensor.nome}!"
        )

        return

    # Ataque normal
    dano, foi_super_efetivo = calcular_dano(
        atacante,
        golpe_escolhido,
        defensor
    )

    golpe_escolhido.gastar_combustivel()

    defensor.receber_dano(dano)

    print(
        f"\n{atacante.nome} usou "
        f"{golpe_escolhido.nome} "
        f"({golpe_escolhido.tipo})!"
    )

    print(
        f"Causou {dano} de dano em "
        f"{defensor.nome}!"
    )

    if foi_super_efetivo:
        print("🔥 É SUPER EFETIVO!")

    print(
        f"Combustível restante: "
        f"{golpe_escolhido.status_combustivel()}"
    )


# =========================================================
# Verificar vencedor
# =========================================================

def verificar_vencedor(p1, p2):

    if not p1.esta_vivo():
        return p2

    if not p2.esta_vivo():
        return p1

    return None


# =========================================================
# Jogar uma partida
# =========================================================

def jogar_partida(pokedex):

    indice_jogador, jogador = (
        escolher_pokemon_jogador(pokedex)
    )

    computador = escolher_pokemon_computador(
        pokedex,
        indice_jogador
    )

    print("\n===================================")
    print(
        f"Você escolheu: "
        f"{jogador.nome} ({jogador.tipo})"
    )

    print(
        f"Seu adversário é: "
        f"{computador.nome} ({computador.tipo})"
    )

    print("===================================\n")

    turno = 1
    vencedor = None

    while vencedor is None:

        print(f"\n========== TURNO {turno} ==========")

        # -------------------------------------------------
        # Jogador ataca
        # -------------------------------------------------

        golpe_jogador = (
            jogador.escolher_golpe_jogador()
        )

        atacar(
            jogador,
            golpe_jogador,
            computador
        )

        vencedor = verificar_vencedor(
            jogador,
            computador
        )

        # -------------------------------------------------
        # Computador ataca
        # -------------------------------------------------

        if vencedor is None:

            golpe_computador = (
                computador.escolher_golpe_aleatorio()
            )

            atacar(
                computador,
                golpe_computador,
                jogador
            )

            vencedor = verificar_vencedor(
                jogador,
                computador
            )

        # -------------------------------------------------
        # Status
        # -------------------------------------------------

        print("\n------------- STATUS -------------")

        jogador.mostrar_status()
        computador.mostrar_status()

        print("----------------------------------")

        turno += 1

    # =====================================================
    # Resultado final
    # =====================================================

    print("\n===================================")
    print("         FIM DA BATALHA!")
    print("===================================")

    print(
        f"O vencedor foi: {vencedor.nome}! 🏆"
    )


# =========================================================
# Jogar novamente
# =========================================================

def perguntar_jogar_novamente():

    while True:

        resposta = input(
            "\nDeseja jogar novamente? (s/n): "
        ).strip().lower()

        if resposta == "s":
            return True

        if resposta == "n":
            return False

        print(
            "Resposta inválida. "
            "Digite S para sim ou N para não."
        )


# =========================================================
# Programa principal
# =========================================================

def main():

    print("===================================")
    print("   BEM-VINDO À BATALHA POKÉMON!")
    print("===================================")

    pokedex = criar_pokedex()

    continuar_jogando = True

    while continuar_jogando:

        jogar_partida(pokedex)

        continuar_jogando = (
            perguntar_jogar_novamente()
        )

    print("\n===================================")
    print("Valeu por jogar!")
    print("Até a próxima batalha! 👋")
    print("===================================")


# =========================================================
# Início do programa
# =========================================================

if __name__ == "__main__":
    main()
