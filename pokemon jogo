# =========================================================
# Tabela de vantagens de tipo
# =========================================================

TABELA_VANTAGENS = {
    "Fogo": "Planta",
    "Planta": "Água",
    "Água": "Fogo",
    "Elétrico": "Água",
}


# =========================================================
# Classe Magia
# =========================================================

class Magia:
    """Representa um golpe/magia que um Pokémon pode usar."""

    def __init__(self, nome, poder, tipo, combustivel_maximo):
        self.nome = nome
        self.poder = poder
        self.tipo = tipo
        self.combustivel_maximo = combustivel_maximo
        self.combustivel_atual = combustivel_maximo

    # Método com retorno
    def tem_combustivel(self):
        return self.combustivel_atual > 0

    # Método sem retorno
    def gastar_combustivel(self):
        if self.combustivel_atual > 0:
            self.combustivel_atual -= 1

    # Método com retorno
    def status_combustivel(self):
        if self.tem_combustivel():
            return f"{self.combustivel_atual}/{self.combustivel_maximo}"

        return "ESGOTADO"


# =========================================================
# Classe Pokémon
# =========================================================

class Pokemon:
    """Representa um Pokémon participante da batalha."""

    def __init__(self, nome, vida_max, ataque, defesa, tipo):
        self.nome = nome
        self.vida_max = vida_max
        self.vida_atual = vida_max
        self.ataque = ataque
        self.defesa = defesa
        self.tipo = tipo
        self.golpes = []

    # Método sem retorno
    def aprender_golpe(self, magia):
        self.golpes.append(magia)

    # Método com retorno
    def possui_golpe_disponivel(self):
        return any(
            golpe.tem_combustivel()
            for golpe in self.golpes
        )

    # Método com retorno
    def escolher_golpe_aleatorio(self):
        disponiveis = [
            golpe
            for golpe in self.golpes
            if golpe.tem_combustivel()
        ]

        if not disponiveis:
            return None

        return random.choice(disponiveis)

    # Método com retorno
    def escolher_golpe_jogador(self):
        print(f"\nVez de {self.nome}! Escolha uma magia:")

        if not self.possui_golpe_disponivel():
            print("Todas as suas magias estão sem combustível!")
            print("Você usará o Ataque Desesperado.")
            return None

        for indice, golpe in enumerate(self.golpes, start=1):
            print(
                f"  {indice} - {golpe.nome} "
                f"({golpe.tipo}, poder {golpe.poder}) "
                f"[combustível: {golpe.status_combustivel()}]"
            )

        while True:
            entrada = input("Digite o número da magia: ").strip()

            if not entrada.isdigit():
                print("Opção inválida. Digite um número.")
                continue

            indice = int(entrada)

            if indice < 1 or indice > len(self.golpes):
                print("Opção inválida. Escolha uma magia da lista.")
                continue

            golpe = self.golpes[indice - 1]

            if not golpe.tem_combustivel():
                print("Essa magia está sem combustível. Escolha outra.")
                continue

            return golpe

    # Método sem retorno
    def receber_dano(self, dano):
        self.vida_atual -= dano

        if self.vida_atual < 0:
            self.vida_atual = 0

    # Método com retorno
    def esta_vivo(self):
        return self.vida_atual > 0

    # Método sem retorno
    def mostrar_status(self):
        print(
            f"{self.nome} -> "
            f"HP: {self.vida_atual}/{self.vida_max}"
        )


